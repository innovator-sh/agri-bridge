# Copy to .env.local and fill in. Never commit real values.
# Required = the app will not start without it. Optional = the related feature is disabled.

# --- Required -------------------------------------------------------------
# Supabase project URL and service-role key (server only; bypasses RLS, keep secret).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Signs the session cookie. At least 32 characters: openssl rand -base64 48
SESSION_SECRET=generate-with-openssl-rand-base64-48

# --- Recommended ----------------------------------------------------------
# Not used for data access (the browser never talks to Supabase); kept for completeness.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Authorises /api/process-schedules (Vercel Cron sends it as a Bearer token).
# At least 16 characters: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32

# --- Optional integrations ------------------------------------------------
GROQ_API_KEY=
OPENWEATHER_API_KEY=
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=
ML_API_URL=
# Optional Redis REST credentials (reserved for shared rate limiting; the built-in limiter is in-memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Dev seed script only (scripts/seed-dev.mjs) --------------------------
# Leave unset. To seed a DEVELOPMENT project run:
#   ALLOW_SEED=1 SEED_CONFIRM_URL="$NEXT_PUBLIC_SUPABASE_URL" node --env-file=.env.local scripts/seed-dev.mjs
# ALLOW_SEED=
# SEED_CONFIRM_URL=
