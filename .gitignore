# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA files
/public/sw.js
/public/workbox-*.js
/public/worker-*.js
/public/sw.js.map
/public/workbox-*.js.map
/public/worker-*.js.map
# env files: never commit real values, only .env.example
.env
.env.*
!.env.example

# keys / certs
*.pem
*.key

# local-only assistant context and planning notes
.claude/
.notes/
/*.md
!/README.md
!/CLAUDE.md
!/SECURITY.md

# logs
*.log
